{
  "expo": {
    "name": "megasub",
    "slug": "megasub",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.anonymous.megasub",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Megasub uses Face ID to let you log in and unlock the app quickly and securely.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.megasub",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/megasubmain.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/megasubmain.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "ios": {
            "image": "./assets/megasubmain.png",
            "imageWidth": 140
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Megasub to access your contacts so you can pick who to send airtime or data to."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.610379032738-qgicd1bril1d6n43v78ldqmh8bfdacaq"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4A55DD",
          "defaultChannel": "transactions"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "fc4f4a94-3f72-4021-affe-9420f8230609"
      }
    },
    "owner": "kalex235"
  }
}
